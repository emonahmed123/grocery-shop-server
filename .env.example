# Copy this file to .env and fill in your own values.
# Never commit .env; it holds secrets.

# ---- App ----
NODE_ENV=development
PORT=5000

# ---- Database ----
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ---- Auth ----
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Email (Gmail App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="BoroBazar <your-email@gmail.com>"
# frontend page that opens the reset link
RESET_PASS_UI_LINK=http://localhost:3000/reset-password
# the store's address: the only origin allowed to send auth cookies (CORS), and the link in order emails
CLIENT_URL=http://localhost:3000

# ---- Payment ----
STORE_ID=your-store-id
SIGNATURE_KEY=your-signature-key
PAYMENT_URL=https://sandbox.example.com/payment
